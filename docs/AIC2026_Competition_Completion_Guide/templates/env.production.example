# Core
AIC_RELEASE_ID=aic2026_competition_rc1
AIC_ENV=production
AIC_LOG_LEVEL=INFO

# Data stores
AIC_POSTGRES_DSN=
AIC_REDIS_URL=
AIC_QDRANT_URL=
AIC_ES_URL=
AIC_VIDEO_ROOT=

# Models/workers
AIC_QUERY_PLANNER_URL=
AIC_RERANKER_URL=
AIC_VLM_WORKER_URL=

# Feature flags
AIC_ENABLE_QUERY_PREP=false
AIC_ENABLE_EXPANSION=false
AIC_ENABLE_OCR_FUZZY=false
AIC_ENABLE_RULES=false
AIC_ENABLE_DEEP_RERANK=false
AIC_ENABLE_EVENT_SEARCH=true
AIC_ENABLE_TEMPORAL_SEARCH=false

# Deadlines
AIC_SEARCH_TOTAL_DEADLINE_MS=5000
AIC_DENSE_DEADLINE_MS=1200
AIC_SPARSE_DEADLINE_MS=1200
AIC_RERANK_DEADLINE_MS=2500

# Submission
AIC_COMPETITION_SERVER_URL=
AIC_COMPETITION_TOKEN=
AIC_SUBMISSION_CONTRACT_PATH=/app/config/submission_contract.yaml

# Monitoring
AIC_PROMETHEUS_ENABLED=true
AIC_ALERT_WEBHOOK=
