# ffmpeg + scripts/embed_export_keyframes.py, xem README_BRANCH.md. Ngược lại
# `storage/exports_multivideo/*.jsonl` thì GIỮ track: đó là caption/OCR do VLM
# sinh trên Kaggle, đắt để làm lại mà chỉ 15MB.
storage/indexes_multivideo/
storage/exports_l21_enriched/
storage/exports_l21_repaired/

# ---- Pack thi đấu 873 video đã chuyển đổi (620MB JSONL + 346MB vector).
# Sinh lại được: scripts/import_competition_pack.py + AIC2026_competition_clean_v3.zip,
# mất ~6 phút. Xem docs/34_COMPETITION_PACK_IMPORT.md. Khác `exports_multivideo/`
# — cái đó GIỮ track vì là caption/OCR do VLM sinh, đắt để làm lại mà chỉ 15MB.
storage/exports_competition/
storage/exports_pack_*/
storage/processed/embeddings_pack/

# Bản sao lưu thủ công trước mỗi lần backfill — dựng lại được từ git, không
# commit 27MB jsonl trùng lặp.
*.bak
*.bak_*

# ---- Dữ liệu đầu vào thô (giải nén được lại từ archive gốc, 200MB+) ----
# input/L21_V001.mp4 trùng khít storage/raw/videos/L21_V001.mp4; các file gold
# trong input/ trùng khít examples/ — giữ ở đây chỉ để tiện thao tác thủ công.
input/
input*.zip
notebooks/__pycache__/

# Gói chẩn đoán tạm — dựng lại được bằng scripts/, không commit
aic_debug_bundle/
aic_debug_bundle.zip
*.patch

# Dump nặng của harness đo offline — dựng lại được bằng
# scripts/dump_kis_features.py và scripts/dump_avs_candidates.py (mỗi cái ~43
# phút gọi API). Repo chỉ theo dõi file tổng kết nhỏ, xem outputs/ đã có.
outputs/evaluation/kis_features.json
outputs/evaluation/avs_candidates.json
outputs/evaluation/quick/
# Kết quả đã hết hiệu lực: giữ trên đĩa để tra cứu, không commit 19MB số liệu
# mà chính README của nó nói là không dùng để ra quyết định được.
outputs/evaluation/_superseded/*.json
outputs/evaluation/_superseded/**/*.json
.claude/settings.local.json
