{
  "$defs": {
    "ASRSegment": {
      "additionalProperties": false,
      "description": "Scene-clipped projection of an ASR segment on the video timeline.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_sec": {
          "exclusiveMinimum": 0.0,
          "title": "End Sec",
          "type": "number"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "normalized_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text"
        },
        "provenance": {
          "$ref": "#/$defs/ModelProvenance"
        },
        "segment_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_A[0-9]{4}$",
          "title": "Segment Id",
          "type": "string"
        },
        "source_segment_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}_ASR[0-9]{6}$",
          "title": "Source Segment Id",
          "type": "string"
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Id"
        },
        "start_sec": {
          "minimum": 0.0,
          "title": "Start Sec",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "source_segment_id",
        "start_sec",
        "end_sec",
        "text",
        "provenance"
      ],
      "title": "ASRSegment",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Normalized XYXY box, independent of image resolution.",
      "properties": {
        "x1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X1",
          "type": "number"
        },
        "x2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X2",
          "type": "number"
        },
        "y1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y1",
          "type": "number"
        },
        "y2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CaptionRecord": {
      "additionalProperties": false,
      "description": "One model-generated textual view of the keyframe.",
      "properties": {
        "caption_type": {
          "enum": [
            "short",
            "detailed",
            "tags",
            "crop"
          ],
          "title": "Caption Type",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "crop_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "default": "en",
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ModelProvenance"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "caption_type",
        "text",
        "provenance"
      ],
      "title": "CaptionRecord",
      "type": "object"
    },
    "ClipSegment": {
      "additionalProperties": false,
      "description": "One pooled clip window inside a scene.",
      "properties": {
        "action_tags": {
          "items": {
            "type": "string"
          },
          "title": "Action Tags",
          "type": "array"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "clip_config_id": {
          "minLength": 1,
          "title": "Clip Config Id",
          "type": "string"
        },
        "clip_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_C[0-9]{8}_[0-9]{8}$",
          "title": "Clip Id",
          "type": "string"
        },
        "duration_sec": {
          "exclusiveMinimum": 0.0,
          "title": "Duration Sec",
          "type": "number"
        },
        "embedding_refs": {
          "items": {
            "$ref": "#/$defs/EmbeddingReference"
          },
          "title": "Embedding Refs",
          "type": "array"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "end_sec": {
          "exclusiveMinimum": 0.0,
          "title": "End Sec",
          "type": "number"
        },
        "fallback_distance_sec": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Distance Sec"
        },
        "provenance": {
          "$ref": "#/$defs/ModelProvenance"
        },
        "representative_frame_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_F[0-9]{6}$",
          "title": "Representative Frame Id",
          "type": "string"
        },
        "sampled_frame_ids": {
          "items": {
            "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_F[0-9]{6}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Sampled Frame Ids",
          "type": "array"
        },
        "sampling_degraded": {
          "default": false,
          "title": "Sampling Degraded",
          "type": "boolean"
        },
        "sampling_method": {
          "enum": [
            "in_window",
            "nearest_scene_keyframe"
          ],
          "title": "Sampling Method",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "start_sec": {
          "minimum": 0.0,
          "title": "Start Sec",
          "type": "number"
        },
        "video_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}$",
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "clip_id",
        "video_id",
        "scene_id",
        "start_sec",
        "end_sec",
        "duration_sec",
        "start_frame",
        "end_frame",
        "sampled_frame_ids",
        "representative_frame_id",
        "sampling_method",
        "clip_config_id",
        "provenance"
      ],
      "title": "ClipSegment",
      "type": "object"
    },
    "ColorFeature": {
      "additionalProperties": false,
      "description": "Compact color metadata suitable for filtering and result explanation.\n\nBaseline for the \"color_search\" branch (Search Mixing Console W1) — HSV\nhistogram + named dominant colors, optionally broken down by coarse region\n(vd \"upper\"/\"center\"/\"lower\"). Region model tối ưu hơn để sau (calibration,\nregion-aware model) không đổi contract này.",
      "properties": {
        "dominant_colors": {
          "items": {
            "$ref": "#/$defs/NamedColorRatio"
          },
          "maxItems": 8,
          "title": "Dominant Colors",
          "type": "array"
        },
        "dominant_hex": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Dominant Hex",
          "type": "array"
        },
        "histogram_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Histogram Uri"
        },
        "hsv_histogram": {
          "items": {
            "minimum": 0.0,
            "type": "number"
          },
          "title": "Hsv Histogram",
          "type": "array"
        },
        "mean_hsv": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 360.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Hsv"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regions": {
          "additionalProperties": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Regions",
          "type": "object"
        }
      },
      "title": "ColorFeature",
      "type": "object"
    },
    "EmbeddingReference": {
      "additionalProperties": false,
      "description": "Logical embedding and every backend in which it is available.",
      "properties": {
        "dimension": {
          "exclusiveMinimum": 0,
          "title": "Dimension",
          "type": "integer"
        },
        "embedding_name": {
          "minLength": 1,
          "title": "Embedding Name",
          "type": "string"
        },
        "modality": {
          "enum": [
            "image",
            "caption",
            "ocr",
            "multimodal"
          ],
          "title": "Modality",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "normalized": {
          "default": true,
          "title": "Normalized",
          "type": "boolean"
        },
        "storage_locations": {
          "items": {
            "$ref": "#/$defs/VectorLocation"
          },
          "minItems": 1,
          "title": "Storage Locations",
          "type": "array"
        }
      },
      "required": [
        "embedding_name",
        "modality",
        "model_name",
        "dimension",
        "storage_locations"
      ],
      "title": "EmbeddingReference",
      "type": "object"
    },
    "Keyframe": {
      "additionalProperties": false,
      "description": "Complete metadata for one searchable frame inside a scene.",
      "properties": {
        "captions": {
          "items": {
            "$ref": "#/$defs/CaptionRecord"
          },
          "title": "Captions",
          "type": "array"
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorFeature"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "embedding_refs": {
          "items": {
            "$ref": "#/$defs/EmbeddingReference"
          },
          "title": "Embedding Refs",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "frame_idx": {
          "maximum": 999999,
          "minimum": 0,
          "title": "Frame Idx",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "image_path": {
          "title": "Image Path",
          "type": "string"
        },
        "keyframe_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_F[0-9]{6}$",
          "title": "Keyframe Id",
          "type": "string"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/ObjectInstance"
          },
          "title": "Objects",
          "type": "array"
        },
        "ocr_instances": {
          "items": {
            "$ref": "#/$defs/OCRInstance"
          },
          "title": "Ocr Instances",
          "type": "array"
        },
        "quality": {
          "$ref": "#/$defs/QualitySignals"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/KeyframeRole"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "scene_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Score"
        },
        "source_checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Checksum"
        },
        "timestamp_sec": {
          "minimum": 0.0,
          "title": "Timestamp Sec",
          "type": "number"
        },
        "video_id": {
          "pattern": "^L[0-9]{2}_V[0-9]{3}$",
          "title": "Video Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "keyframe_id",
        "video_id",
        "scene_id",
        "frame_idx",
        "timestamp_sec",
        "image_path",
        "width",
        "height",
        "roles"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "KeyframeRole": {
      "description": "Reason why a frame was selected from its parent scene.",
      "enum": [
        "representative",
        "middle",
        "boundary_start",
        "boundary_end",
        "ocr_rich",
        "motion_change",
        "manual"
      ],
      "title": "KeyframeRole",
      "type": "string"
    },
    "ModelProvenance": {
      "additionalProperties": false,
      "description": "Information required to reproduce a generated model output.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "pipeline_version": {
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "model_name",
        "pipeline_version"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "NamedColorRatio": {
      "additionalProperties": false,
      "description": "One named color and the fraction of the keyframe (or region) it covers.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ratio",
          "type": "number"
        }
      },
      "required": [
        "name",
        "ratio"
      ],
      "title": "NamedColorRatio",
      "type": "object"
    },
    "OCRInstance": {
      "additionalProperties": false,
      "description": "A recognized text instance and its exact location in the keyframe.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "normalized_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text"
        },
        "provenance": {
          "$ref": "#/$defs/ModelProvenance"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "confidence",
        "bbox",
        "provenance"
      ],
      "title": "OCRInstance",
      "type": "object"
    },
    "ObjectInstance": {
      "additionalProperties": false,
      "description": "A detected object used as soft search evidence, not a hard truth.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ModelProvenance"
        }
      },
      "required": [
        "label",
        "confidence",
        "bbox",
        "provenance"
      ],
      "title": "ObjectInstance",
      "type": "object"
    },
    "QualitySignals": {
      "additionalProperties": false,
      "description": "Optional signals used to choose or down-rank weak keyframes.",
      "properties": {
        "black_frame_ratio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Black Frame Ratio"
        },
        "brightness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brightness"
        },
        "contrast": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contrast"
        },
        "duplicate_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Score"
        },
        "sharpness": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharpness"
        }
      },
      "title": "QualitySignals",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "Complete searchable scene with nested keyframes and temporal evidence.",
      "properties": {
        "asr_segments": {
          "items": {
            "$ref": "#/$defs/ASRSegment"
          },
          "title": "Asr Segments",
          "type": "array"
        },
        "boundary_confidence_in": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Confidence In"
        },
        "boundary_confidence_out": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Confidence Out"
        },
        "captions": {
          "items": {
            "$ref": "#/$defs/SceneCaptionRecord"
          },
          "title": "Captions",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "embedding_refs": {
          "items": {
            "$ref": "#/$defs/EmbeddingReference"
          },
          "title": "Embedding Refs",
          "type": "array"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "end_sec": {
          "exclusiveMinimum": 0.0,
          "title": "End Sec",
          "type": "number"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
