{
  "$defs": {
    "EmbeddingReference": {
      "additionalProperties": false,
      "description": "Logical embedding and every backend in which it is available.",
      "properties": {
        "dimension": {
          "exclusiveMinimum": 0,
          "title": "Dimension",
          "type": "integer"
        },
        "embedding_name": {
          "minLength": 1,
          "title": "Embedding Name",
          "type": "string"
        },
        "modality": {
          "enum": [
            "image",
            "caption",
            "ocr",
            "multimodal"
          ],
          "title": "Modality",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "normalized": {
          "default": true,
          "title": "Normalized",
          "type": "boolean"
        },
        "storage_locations": {
          "items": {
            "$ref": "#/$defs/VectorLocation"
          },
          "minItems": 1,
          "title": "Storage Locations",
          "type": "array"
        }
      },
      "required": [
        "embedding_name",
        "modality",
        "model_name",
        "dimension",
        "storage_locations"
      ],
      "title": "EmbeddingReference",
      "type": "object"
    },
    "ModelProvenance": {
      "additionalProperties": false,
      "description": "Information required to reproduce a generated model output.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "pipeline_version": {
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "model_name",
        "pipeline_version"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "VectorLocation": {
      "additionalProperties": false,
      "description": "One physical location of a vector in FAISS, Qdrant, or a file.",
      "properties": {
        "backend": {
          "enum": [
            "faiss",
            "qdrant",
            "file"
          ],
          "title": "Backend",
          "type": "string"
        },
        "index_name": {
          "minLength": 1,
          "title": "Index Name",
          "type": "string"
        },
        "vector_id": {
          "minLength": 1,
          "title": "Vector Id",
          "type": "string"
        },
        "vector_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector Uri"
        }
      },
      "required": [
        "backend",
        "vector_id",
        "index_name"
      ],
      "title": "VectorLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One pooled clip window inside a scene.",
  "properties": {
    "action_tags": {
      "items": {
        "type": "string"
      },
      "title": "Action Tags",
      "type": "array"
    },
    "caption": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caption"
    },
    "clip_config_id": {
      "minLength": 1,
      "title": "Clip Config Id",
      "type": "string"
    },
    "clip_id": {
      "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_C[0-9]{8}_[0-9]{8}$",
      "title": "Clip Id",
      "type": "string"
    },
    "duration_sec": {
      "exclusiveMinimum": 0.0,
      "title": "Duration Sec",
      "type": "number"
    },
    "embedding_refs": {
      "items": {
        "$ref": "#/$defs/EmbeddingReference"
      },
      "title": "Embedding Refs",
      "type": "array"
    },
    "end_frame": {
      "exclusiveMinimum": 0,
      "title": "End Frame",
      "type": "integer"
    },
    "end_sec": {
      "exclusiveMinimum": 0.0,
      "title": "End Sec",
      "type": "number"
    },
    "fallback_distance_sec": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Distance Sec"
    },
    "provenance": {
      "$ref": "#/$defs/ModelProvenance"
    },
    "representative_frame_id": {
      "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_F[0-9]{6}$",
      "title": "Representative Frame Id",
      "type": "string"
    },
    "sampled_frame_ids": {
      "items": {
        "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}_F[0-9]{6}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Sampled Frame Ids",
      "type": "array"
    },
    "sampling_degraded": {
      "default": false,
      "title": "Sampling Degraded",
      "type": "boolean"
    },
    "sampling_method": {
      "enum": [
        "in_window",
        "nearest_scene_keyframe"
      ],
      "title": "Sampling Method",
      "type": "string"
    },
    "scene_id": {
      "pattern": "^L[0-9]{2}_V[0-9]{3}_S[0-9]{4}$",
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "start_frame": {
      "minimum": 0,
      "title": "Start Frame",
      "type": "integer"
    },
    "start_sec": {
      "minimum": 0.0,
      "title": "Start Sec",
      "type": "number"
    },
    "video_id": {
      "pattern": "^L[0-9]{2}_V[0-9]{3}$",
      "title": "Video Id",
      "type": "string"
    }
  },
  "required": [
    "clip_id",
    "video_id",
    "scene_id",
    "start_sec",
    "end_sec",
    "duration_sec",
    "start_frame",
    "end_frame",
    "sampled_frame_ids",
    "representative_frame_id",
    "sampling_method",
    "clip_config_id",
    "provenance"
  ],
  "title": "ClipSegment",
  "type": "object"
}
