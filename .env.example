# Shared
AIC_DATA_ROOT=storage
AIC_PIPELINE_VERSION=aic-v1.0.0

# Offline controller (local machine or Vast job)
AIC_INPUT_DIR=storage/raw/videos
AIC_EXPORT_DIR=storage/exports
AIC_STATE_DIR=storage/state
AIC_OFFLINE_PROVIDER=mock
AIC_GPU_URL=http://localhost:8010
AIC_GPU_API_KEY=change-me
AIC_GPU_TIMEOUT_SEC=120
AIC_GPU_RETRIES=3
AIC_SCENE_SECONDS=8
AIC_KEYFRAMES_PER_SCENE=1
AIC_INDEX_ENCODER=local

# Online backend
AIC_ONLINE_BACKEND=local
AIC_METADATA_JSONL=storage/exports/scenes.jsonl
AIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AIC_ONLINE_API_KEY=
AIC_CANDIDATE_LIMIT=100
AIC_RRF_K=60
AIC_REQUEST_TIMEOUT_SEC=15
# Wire có cờ cho 4 module retrieval đã code sẵn nhưng chưa bật mặc định — xem
# docs/14_TECHNICAL_PREPARATION.md mục "Đã làm" và docs/15_RESEARCH_AGENDA.md.
# Mặc định tắt hết (false); chỉ bật sau khi đo Recall@K/MRR qua scripts/eval_kis.py.
AIC_ENABLE_OCR_FUZZY=false
AIC_ENABLE_QUERY_PREP=false
AIC_ENABLE_EXPANSION=false
AIC_ENABLE_RULES=false
# Search Mixing Console W3 (online/api/container.py) — mặc định tắt hết, mỗi cờ chỉ nên
# bật sau khi đo Recall@K/MRR qua scripts/eval_kis.py (xem docs/14 mục W3).
AIC_ENABLE_OBJECT_SEARCH=false
AIC_ENABLE_ACTION_SEARCH=false
AIC_ENABLE_COLOR_SEARCH=false
AIC_ENABLE_EVENT_SEARCH=false

# scripts/caption_qwen3vl.py (Qwen3-VL-32B caption làm giàu, xem docs/14 + docs/05 mục
# "Triển khai 1×A100 tuần tự 3 pha") - đọc trực tiếp từ file .env ở gốc repo, KHÔNG qua
# Settings.from_env (script độc lập, không chạy trong FastAPI). Không commit giá trị thật,
# chỉ đổi ở .env cục bộ.
OPENROUTER_API_KEY=
# "openrouter" (mặc định, trả theo token, không cần GPU riêng, chỉ cần OPENROUTER_API_KEY)
# hoặc "vllm" (tự host — bắt buộc điền AIC_QWEN3VL_SERVER_URL, validate lúc chạy, không
# âm thầm rơi về provider khác nếu thiếu biến).
AIC_QWEN3VL_PROVIDER=openrouter
AIC_QWEN3VL_SERVER_URL=
AIC_QWEN3VL_MODEL=
AIC_QWEN3VL_API_KEY=
# Số scene chạy thử trước khi chạy toàn bộ corpus. Để RỖNG (không xoá dòng, chỉ để trống
# sau dấu =) khi đã sẵn sàng chạy hết — khác với việc không set biến này chút nào.
AIC_QWEN3VL_LIMIT=1
# Mặc định 2 cho cả 2 provider (Qwen3-VL-32B BF16 rất sát VRAM 1 A100 80GB) — tăng dần sau
# khi benchmark thật, xem docs/05_VAST_DEPLOYMENT.md.
AIC_QWEN3VL_MAX_WORKERS=

# Qdrant + encoder (production profile)
AIC_QDRANT_URL=http://qdrant:6333
AIC_QDRANT_API_KEY=
AIC_QDRANT_SCENE_COLLECTION=aic_scenes_v1
AIC_QDRANT_VECTOR_NAME=visual
AIC_EMBEDDING_URL=http://worker:8010/v1/embed/text
AIC_EMBEDDING_API_KEY=change-me

# GPU worker
AIC_GPU_PROVIDER=mock
# Production: transformers; model names below can be pinned to a local revision.
# AIC_CAPTION_MODEL now serves BOTH caption and semantic OCR (Qwen2.5-VL chat model,
# needs a real CUDA GPU e.g. Kaggle T4x2 — see docs/KAGGLE_OFFLINE_GUIDE.md).
AIC_CAPTION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
AIC_CAPTION_MODEL_REVISION=
AIC_CAPTION_MAX_TOKENS=120
AIC_OBJECT_MODEL=google/owlv2-base-patch16-ensemble
AIC_OBJECT_MODEL_REVISION=
AIC_EMBEDDING_MODEL=openai/clip-vit-large-patch14
AIC_EMBEDDING_MODEL_REVISION=
AIC_ASR_MODEL=openai/whisper-large-v3-turbo
AIC_ASR_MODEL_REVISION=
# Rỗng = HF mặc định lấy "main" (không pin) — điền commit hash/tag cụ thể trước khi thi
# đấu để tránh checkpoint đổi ngầm giữa lúc enrich và lúc build lại (xem docs/13 mục 1).

# scripts/caption_qwen3vl.py (chỉ dùng cho caption, KHÔNG dùng cho OCR — xem docs/14):
# model/revision sửa trực tiếp trong file (biến MODEL ở "USER CONFIG") vì OpenRouter/vLLM
# không nhận revision qua request như transformers.from_pretrained — không thêm biến env
# giả ở đây để tránh cấu hình chết không ai đọc.

# Model target CHƯA có code tích hợp (docs/13 mục 1) — điền khi chọn checkpoint, dùng lúc
# viết code thật trên máy GPU đã thuê. Để trống = "pending", KHÔNG suy đoán trước.
AIC_SIGLIP2_MODEL_REVISION=
AIC_OPENCLIP_PRETRAINED_TAG=
AIC_YOLO_MODEL_REVISION=
AIC_GROUNDING_DINO_MODEL_REVISION=
AIC_WHISPERX_ALIGN_MODEL_REVISION=
AIC_GPU_CONCURRENCY=2
AIC_MAX_IMAGE_BYTES=20000000
