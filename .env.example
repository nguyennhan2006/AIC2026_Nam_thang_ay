# ============================================================
# Shared
# ============================================================

AIC_DATA_ROOT=storage
AIC_PIPELINE_VERSION=aic-v1.0.0

# Profile:
# - local_mock
# - fpt_acceptance
# - vast_production
AIC_RUNTIME_PROFILE=local_mock


# ============================================================
# Offline controller
# ============================================================

AIC_INPUT_DIR=storage/raw/videos
AIC_EXPORT_DIR=storage/exports
AIC_STATE_DIR=storage/state

# mock | fpt | gpu_worker
AIC_OFFLINE_PROVIDER=mock

# Chỉ dùng khi AIC_OFFLINE_PROVIDER=gpu_worker
AIC_GPU_URL=http://localhost:8010
AIC_GPU_API_KEY=change-me
AIC_GPU_TIMEOUT_SEC=120
AIC_GPU_RETRIES=3

AIC_SCENE_SECONDS=8
AIC_KEYFRAMES_PER_SCENE=1
AIC_INDEX_ENCODER=local


# ============================================================
# Online backend
# ============================================================

AIC_ONLINE_BACKEND=local
AIC_METADATA_JSONL=storage/exports/scenes.jsonl

AIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AIC_ONLINE_API_KEY=

AIC_CANDIDATE_LIMIT=100
AIC_RRF_K=60
AIC_REQUEST_TIMEOUT_SEC=15


# ============================================================
# Optional retrieval branches
# Chỉ bật sau khi đã đo trên query set.
# ============================================================

AIC_ENABLE_OCR_FUZZY=false
AIC_ENABLE_QUERY_PREP=false
AIC_ENABLE_EXPANSION=false
AIC_ENABLE_RULES=false

AIC_ENABLE_OBJECT_SEARCH=false
AIC_ENABLE_ACTION_SEARCH=false
AIC_ENABLE_COLOR_SEARCH=false
AIC_ENABLE_EVENT_SEARCH=false


# ============================================================
# Provider-neutral model routing
# Service chỉ đọc các biến này.
# ============================================================

# Query understanding / decomposition / expansion
AIC_QUERY_LLM_PROVIDER=mock
AIC_QUERY_LLM_MODEL=

# QA text answer and verifier
AIC_QA_LLM_PROVIDER=mock
AIC_QA_LLM_MODEL=
AIC_QA_VERIFIER_PROVIDER=mock
AIC_QA_VERIFIER_MODEL=

# Vision-language model
AIC_VLM_PROVIDER=mock
AIC_VLM_MODEL=

# Text reranker
AIC_TEXT_RERANK_PROVIDER=mock
AIC_TEXT_RERANK_MODEL=

# Text semantic embedding
AIC_TEXT_EMBEDDING_PROVIDER=mock
AIC_TEXT_EMBEDDING_MODEL=

# Speech-to-text
AIC_ASR_PROVIDER=mock
AIC_ASR_MODEL=

# Visual embedding phải luôn tách khỏi text embedding.
AIC_VISUAL_EMBEDDING_PROVIDER=local
AIC_VISUAL_EMBEDDING_MODEL=openai/clip-vit-large-patch14
AIC_VISUAL_EMBEDDING_MODEL_REVISION=


# ============================================================
# FPT AI Marketplace
# Chỉ đặt key thật trong .env/.env.local.
# ============================================================

AIC_FPT_ENABLED=false
AIC_FPT_BASE_URL=https://mkp-api.fptcloud.com
AIC_FPT_API_KEY=

AIC_FPT_TIMEOUT_SEC=90
AIC_FPT_CONNECT_TIMEOUT_SEC=10
AIC_FPT_MAX_RETRIES=3
AIC_FPT_MAX_CONCURRENCY=2
AIC_FPT_RETRY_BACKOFF_BASE_SEC=1.0
AIC_FPT_RETRY_BACKOFF_MAX_SEC=8.0

# Exact model IDs phải được xác nhận bằng FPT Playground/Product Information.
AIC_FPT_QUERY_LLM_MODEL=Qwen3.6-27B
AIC_FPT_FAST_LLM_MODEL=DeepSeek-V4-Flash
AIC_FPT_DEEP_LLM_MODEL=gpt-oss-120b

AIC_FPT_VLM_MODEL=Qwen2.5-VL-7B-Instruct
AIC_FPT_RERANK_MODEL=bge-reranker-v2-m3

AIC_FPT_TEXT_EMBEDDING_MODEL=multilingual-e5-large
AIC_FPT_VI_EMBEDDING_MODEL=Vietnamese_Embedding

AIC_FPT_ASR_MODEL=whisper-large-v3-turbo
AIC_FPT_ASR_FALLBACK_MODEL=FPT.AI-whisper-medium

# Không dùng trong video retrieval, chỉ lưu để capability probe khi cần.
AIC_FPT_TTS_MODEL=FPT.AI-VITs

# Không ghi request/response chứa dữ liệu thật trong CI.
AIC_LOG_REQUEST_BODY=false
AIC_LOG_PROVIDER_RESPONSE=false
AIC_REDACT_SECRETS=true


# ============================================================
# FPT acceptance profile
# Copy các dòng này vào .env.local khi test.
# ============================================================

# AIC_RUNTIME_PROFILE=fpt_acceptance
# AIC_FPT_ENABLED=true
# AIC_OFFLINE_PROVIDER=fpt
#
# AIC_QUERY_LLM_PROVIDER=fpt
# AIC_QUERY_LLM_MODEL=Qwen3.6-27B
#
# AIC_QA_LLM_PROVIDER=fpt
# AIC_QA_LLM_MODEL=Qwen3.6-27B
# AIC_QA_VERIFIER_PROVIDER=fpt
# AIC_QA_VERIFIER_MODEL=Qwen3.6-27B
#
# AIC_VLM_PROVIDER=fpt
# AIC_VLM_MODEL=Qwen2.5-VL-7B-Instruct
#
# AIC_TEXT_RERANK_PROVIDER=fpt
# AIC_TEXT_RERANK_MODEL=bge-reranker-v2-m3
#
# AIC_TEXT_EMBEDDING_PROVIDER=fpt
# AIC_TEXT_EMBEDDING_MODEL=multilingual-e5-large
#
# AIC_ASR_PROVIDER=fpt
# AIC_ASR_MODEL=whisper-large-v3-turbo
#
# Giữ visual embedding local trong lần test đầu.
# AIC_VISUAL_EMBEDDING_PROVIDER=local
# AIC_VISUAL_EMBEDDING_MODEL=openai/clip-vit-large-patch14


# ============================================================
# Qwen enrichment script — legacy compatibility
# ============================================================

# fpt | openrouter | vllm
AIC_QWEN3VL_PROVIDER=openrouter

OPENROUTER_API_KEY=

AIC_QWEN3VL_SERVER_URL=
AIC_QWEN3VL_MODEL=
AIC_QWEN3VL_API_KEY=

AIC_QWEN3VL_LIMIT=1
AIC_QWEN3VL_MAX_WORKERS=


# ============================================================
# Qdrant + encoder
# ============================================================

AIC_QDRANT_URL=http://qdrant:6333
AIC_QDRANT_API_KEY=

AIC_QDRANT_SCENE_COLLECTION=aic_scenes_v1
AIC_QDRANT_VECTOR_NAME=visual

# Chỉ dùng khi text embedding được host riêng.
AIC_TEXT_EMBEDDING_URL=http://worker:8010/v1/embed/text
AIC_TEXT_EMBEDDING_API_KEY=change-me

# Visual embedding endpoint tách riêng.
AIC_VISUAL_EMBEDDING_URL=http://worker:8010/v1/embed/image
AIC_VISUAL_EMBEDDING_API_KEY=change-me


# ============================================================
# GPU worker / VastAI
# ============================================================

# mock | transformers
AIC_GPU_PROVIDER=mock

AIC_CAPTION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
AIC_CAPTION_MODEL_REVISION=
AIC_CAPTION_MAX_TOKENS=120

AIC_OBJECT_MODEL=google/owlv2-base-patch16-ensemble
AIC_OBJECT_MODEL_REVISION=

AIC_GPU_VISUAL_EMBEDDING_MODEL=openai/clip-vit-large-patch14
AIC_GPU_VISUAL_EMBEDDING_MODEL_REVISION=

AIC_GPU_ASR_MODEL=openai/whisper-large-v3-turbo
AIC_GPU_ASR_MODEL_REVISION=

AIC_SIGLIP2_MODEL_REVISION=
AIC_OPENCLIP_PRETRAINED_TAG=
AIC_YOLO_MODEL_REVISION=
AIC_GROUNDING_DINO_MODEL_REVISION=
AIC_WHISPERX_ALIGN_MODEL_REVISION=

AIC_GPU_CONCURRENCY=2
AIC_MAX_IMAGE_BYTES=20000000


# ============================================================
# Rerank cascade compatibility
# ============================================================

AIC_RERANK_TEXT_URL=
AIC_RERANK_VLM_URL=
AIC_RERANK_API_KEY=

AIC_RERANK_TEXT_MODEL=bge-reranker-v2-m3
AIC_RERANK_VLM_MODEL=qwen3-vl-32b


# ============================================================
# VastAI production profile
# Copy vào .env server, giữ service contracts giống FPT.
# ============================================================

